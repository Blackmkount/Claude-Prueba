# Datos de tu impresora para el CLI de prueba (Fase 1).
# Copia este archivo como .env y llena los valores. El archivo .env NO se sube al repositorio.

# IP de la impresora (en la pantalla de la A1: Ajustes → WLAN / Red)
PRINTER_IP=192.168.1.50

# Código de acceso LAN (en la pantalla de la A1: Ajustes → "Modo solo LAN")
PRINTER_ACCESS_CODE=12345678

# Número de serie (opcional: si lo dejas vacío, se detecta solo a partir del certificado de la impresora)
PRINTER_SERIAL=

# --- Opciones avanzadas (normalmente no se tocan) ---
# PRINTER_MQTT_PORT=8883
# PRINTER_FTPS_PORT=990
# Verificar el certificado de la impresora con la CA de Bambu (recomendado: true)
# PRINTER_TLS_VERIFY=true
# Archivo de CA alternativo (solo para el simulador)
# PRINTER_CA_FILE=
