{
  "name": "blackforge-simulador-a1",
  "private": true,
  "version": "0.2.0",
  "description": "Simulador de impresoras Bambu Lab A1 (MQTT + FTPS falsos) para desarrollar y probar BlackForge Print sin impresoras.",
  "type": "module",
  "scripts": {
    "sim": "tsx src/main.ts",
    "typecheck": "tsc --noEmit"
