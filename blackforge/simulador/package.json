  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "aedes": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "mqtt-packet": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
